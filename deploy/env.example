# /etc/ai-company/env — root-only (chmod 600). Values in single quotes.
# Login (required on a server). Hash: echo -n 'your password' | /opt/ai-company/ai-company hash-password
AUTH_USER='admin'
AUTH_PASSWORD_HASH=''
# Where project previews are served (its own origin, see nginx-ai-company.conf).
PREVIEW_ORIGIN='https://example.com:9444'
# Continue the projects an update interrupted.
RESUME_ON_START='1'
# Model proxy (9router) key used by employees with provider "custom".
CUSTOM_API_KEY=''
# Tab "Tài nguyên": 9router dashboard on this server.
NINEROUTER_URL='http://127.0.0.1:20128'
NINEROUTER_PASSWORD=''
