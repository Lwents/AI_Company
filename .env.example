# Sao chép thành .env rồi điền khóa của nhà cung cấp bạn dùng. Không commit file .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Ollama chạy local, không cần khóa
OLLAMA_BASE_URL=http://localhost:11434/v1
# Endpoint OpenAI-compatible tùy chỉnh (nhập Base URL trong bảng Nhân sự)
CUSTOM_API_KEY=
# Cổng web (mặc định 8787)
PORT=8787
# Mở Cổng khách hàng cho máy khác (chỉ cổng khách hàng + sản phẩm, không mở quản trị)
# PORTAL_BIND=0.0.0.0:8790

# 9router dashboard — tab "Tài nguyên" đọc tài khoản + quota. Nhiều nguồn: phân tách bằng dấu phẩy (vd. https://ip-vps,http://127.0.0.1:20128)
NINEROUTER_URL=http://127.0.0.1:20128
NINEROUTER_PASSWORD=
